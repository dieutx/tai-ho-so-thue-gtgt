# Sao chép file này thành .env rồi điền thông tin thật.
# .env đã nằm trong .gitignore, không bao giờ được commit hay push lên GitHub.

# --- Bắt buộc ---
GDT_USERNAME=ma_so_thue-QL
GDT_PASSWORD=mat_khau_thue_dien_tu

# --- Khoảng ngày (dd/mm/yyyy) ---
# Có thể dài hơn 31 ngày; chương trình tự chia nhỏ.
GDT_FROM_DATE=01/06/2025
GDT_TO_DATE=30/06/2025
GDT_DOWNLOAD_DIR=download

# --- Không bắt buộc ---

# Chỉ tải một hồ sơ cụ thể.
# GDT_CASE_ID=11320250292469209

# Bộ nhận dạng CAPTCHA: ddddocr (mặc định), easyocr, paddleocr, manual, remote,
# hoặc module:ClassName tự đăng ký.
GDT_CAPTCHA_SOLVER=ddddocr

# Tham số cho solver, dạng JSON.
# GDT_CAPTCHA_OPTIONS={"gpu": false, "scale": 5}
# GDT_CAPTCHA_OPTIONS={"url": "https://example.com/solve", "api_key": "..."}

# Đăng ký solver riêng mà không cần sửa code (name=module:ClassName).
# GDT_CAPTCHA_PLUGINS=myocr=goi_cua_toi.solver:MyOcrSolver

# Quy tắc ngày tháng.
# GDT_ETAX_CUTOFF=01/07/2025
# Số ngày mỗi đoạn phải nằm trong khoảng 1–31.
# GDT_MAX_DAYS_PER_SEARCH=31

# Trước cutoff dùng trực tiếp legacy; không cần đăng nhập DVC trước.
GDT_LEGACY_ETAX=true
# Tạm tắt toàn bộ DVC. Có thể mở lại bằng --enable-dvc hoặc đổi thành true.
GDT_DVC_ENABLED=false
# Khi DVC tắt, ngày từ cutoff trở đi bị bỏ qua và mã thoát là 1.
# GDT_LEGACY_ETAX=false chỉ dành cho kiểm tra adapter ETAX trên DVC khi đã mở lại.

# --- Giấy nộp tiền (GNT) ---
# Tra cứu/tải XML giấy nộp tiền bằng lệnh riêng: python -m gdt_tax.gnt (hoặc gdt-gnt).
# Dùng chung tài khoản, khoảng ngày GDT_FROM_DATE/GDT_TO_DATE, thư mục
# GDT_DOWNLOAD_DIR, solver, proxy, log, header... Lệnh GNT không có biến môi trường
# riêng; kết quả là file XML và danh_sach_giay_nop_tien.xlsx/.csv/.json.

# --- Thông báo của cơ quan thuế ---
# Tra cứu/tải PDF thông báo bằng lệnh riêng: python -m gdt_tax.tb (hoặc gdt-tb).
# Cũng dùng chung tài khoản, khoảng ngày, thư mục, solver, proxy, log, header...
# Lệnh TB không có biến môi trường riêng; kết quả là file PDF và
# danh_sach_thong_bao.xlsx/.csv/.json. Khoảng ngày lọc theo ngày gửi thông báo.

# Hiệu năng và độ kiên nhẫn.
# GDT_PAGE_SIZE=10
# GDT_LOGIN_ATTEMPTS=10
# GDT_SEARCH_ATTEMPTS=6
# GDT_REQUEST_TIMEOUT=30
# GDT_HTTP_RETRIES=3
# GDT_PAUSE_BETWEEN_RECORDS=1
# GDT_PAUSE_BETWEEN_PAGES=3

# Tỉ lệ ngẫu nhiên cộng thêm vào mỗi lần nghỉ (0–1) để nhịp không đều như máy.
# Chỉ cộng thêm thời gian, không bao giờ rút ngắn.
# GDT_PAUSE_JITTER=0.3

# Chỉ tra cứu, không tải ZIP.
# GDT_DRY_RUN=false

# --- Proxy (bắt buộc khi chạy trên máy chủ ngoài Việt Nam) ---
# Cổng Dịch vụ công chỉ phục vụ IP Việt Nam. Chạy từ VPS nước ngoài mà không có
# proxy Việt Nam sẽ bị chặn ngay ở tầng kết nối. Nhận các dạng:
#   host:port                          -> 1.2.3.4:8080
#   host:port:tài-khoản:mật-khẩu       -> 1.2.3.4:8080:muaproxy:matkhau
#   tài-khoản:mật-khẩu@host:port       -> muaproxy:matkhau@1.2.3.4:8080
#   URL đầy đủ http/https/socks*       -> socks5://muaproxy:matkhau@1.2.3.4:1080
# Mật khẩu proxy được che bằng *** trong mọi log. Đừng dán giá trị này vào issue hay pull request.
# GDT_PROXY_URL=1.2.3.4:8080:tai-khoan:mat-khau

# --- Header gửi đi ---
# browser (mặc định): gửi như Chrome thật — Sec-Fetch-*, sec-ch-ua*, đúng thứ tự
#   header — để cổng không phân biệt được với người dùng đang đăng nhập bằng browser.
# minimal: chỉ User-Agent và Accept-Language, dùng khi cần loại trừ lỗi do header.
# GDT_HEADER_PROFILE=browser

# --- Chẩn đoán khi cổng thay đổi ---
# Header thêm hoặc ghi đè cho mọi request, dạng JSON. Dùng khi cổng yêu cầu thêm
# header mới mà chưa cần sửa mã nguồn.
# GDT_EXTRA_HEADERS={"Referer": "https://dichvucong.gdt.gov.vn/tthc/tchs"}

# Ghi metadata HTTP đã làm sạch và hash ra file; không ghi payload gốc.
# Một số trường như Cookie, matKhau, _password, _csrf được che bằng ***.
# URL/Referer và response thô vẫn có thể chứa bí mật; không chia sẻ log chưa ẩn danh.
# GDT_LOG_FILE=logs/run.log

# Lưu metadata/hash request/response; không tự ghi raw body.
# Bật raw response bằng GDT_HTTP_DUMP_PRIVATE=true hoặc --dump-http-private.
# Raw nằm trong PRIVATE, giới hạn 100 request/15 phút, không commit/chia sẻ.
# GDT_HTTP_DUMP_DIR=http-dump
# GDT_HTTP_DUMP_PRIVATE=false
